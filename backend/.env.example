# Salin file ini menjadi .env lalu isi. JANGAN commit file .env ke GitHub.

DATABASE_URL=postgresql://postgres:PASSWORD_KAMU@localhost:5432/semfs_db

# Wajib minimal 32 karakter. Buat dengan:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

# Tujuan email dari tombol "Hubungi Support" (kosong = pakai SMTP_FROM)
SUPPORT_EMAIL=

# Alamat frontend (dipakai untuk tautan reset password dan CORS)
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Reset password: true = pesan "Email tidak ditemukan" (sesuai SRS), false = jawaban selalu sama (lebih aman)
RESET_REVEAL_UNKNOWN_EMAIL=true
RESET_TOKEN_EXPIRE_MINUTES=60

# Email (opsional). Kosongkan SMTP_HOST untuk mode dev: tautan reset dicetak di terminal uvicorn.
# Contoh Gmail (pakai "App Password", bukan password akun):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=emailkamu@gmail.com
# SMTP_PASSWORD=app-password-16-huruf
# SMTP_FROM=emailkamu@gmail.com
SMTP_HOST=
